---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatNoteDate,
  getBacklinks,
  getNoteSlug,
  getNoteUrl,
  getNotes,
  toTagSlug,
} from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({
    params: { slug: getNoteSlug(note.id) },
    props: { note, notes },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
  notes: CollectionEntry<"notes">[];
}

const { note, notes } = Astro.props;
const { Content } = await note.render();
const backlinks: CollectionEntry<"notes">[] = getBacklinks(notes, getNoteSlug(note.id));
---

<BaseLayout title={note.data.title} description={note.data.description} lang={note.data.lang}>
  <article class="content note-content">
    <header class="post-header">
      <h1 data-pagefind-meta="title">{note.data.title}</h1>
      <div class="note-meta">
        <time datetime={note.data.updated.toISOString()}>
          Updated {formatNoteDate(note.data.updated, note.data.lang)}
        </time>
        {
          note.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">
              {note.data.tags.map((tag) => (
                <li>
                  <a href={`/notes/tags/${toTagSlug(tag)}/`} data-pagefind-filter="tag">{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <div data-pagefind-body>
      <Content />
    </div>
    {
      backlinks.length > 0 && (
        <footer class="backlinks">
          <h2>Backlinks</h2>
          <ul>
            {backlinks.map((backlink) => (
              <li>
                <a href={getNoteUrl(backlink.id)}>{backlink.data.title}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>
